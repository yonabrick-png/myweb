{
  "name": "yona-runs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:content && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/check-content.mjs",
    "test:e2e": "playwright test",
    "build:artifact": "npm run check:content && vite build --mode artifact && node scripts/inline-artifact.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "animejs": "^4.5.0",
    "lenis": "^1.3.26",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
